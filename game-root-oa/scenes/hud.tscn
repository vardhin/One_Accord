custom_minimum_size = Vector2(210, 0)
text = "[b]Controls[/b]
[color=#cfe]WASD[/color]   Move
[color=#cfe]Mouse[/color]  Look
[color=#cfe]Shift[/color]  Sprint
[color=#cfe]Space[/color]  Jump
[color=#cfe]R[/color]      Draw / sheath sword
[color=#cfe]LMB[/color]    Light attack (combo)
[color=#cfe]RMB[/color]    Heavy attack
[color=#cfe]1 2 3[/color]  Select spell
[color=#cfe]Q[/color]      Cast (tap = fire, hold = channel)
[color=#fd9]B[/color]      Debug: hold = force beam (tune muzzle)
[color=#cfe]Y[/color]      Fullscreen
[color=#cfe]H[/color]      Hide / show this
[color=#cfe]Esc[/color]    Free mouse

[b]Pose / animation tool[/b]
[color=#fd9]K[/color]      Enter pose mode
[color=#9cf]       [/color] (panels + on-screen help appear)"
