# ── Godot 4 (game-root-oa/) ──────────────────────────────────────────────
# Editor/runtime cache — regenerated on open; never commit.
.godot/
# Godot 3 legacy import cache (harmless if absent).
.import/

# Exported builds / packaged game.
/game-root-oa/build/
/game-root-oa/export/
/game-root-oa/exports/
*.exe
*.pck
*.x86_64
*.app
*.dmg
*.apk
*.aab
# Per-machine export config (paths, keystores). Keep export_presets.cfg if shared.
export_presets.cfg

# Mono / C# (only if a C# build is ever added).
.mono/
/game-root-oa/data_*/

# ── Rust GDExtension (sim core — see Systems-Doc/02-engine-evaluation.md) ──
# Uncomment/adjust once the Rust crate lands.
target/
**/target/
Cargo.lock.orig
*.rs.bk
# Compiled native extension libraries.
*.so
*.dll
*.dylib

# ── Local LLM (llama.cpp service — see Production/vertical-slice-spec.md) ──
# Model weights are large and live in ~/.cache/huggingface; never vendor them.
*.gguf
/models/

# ── OS / editor cruft ────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini
*~
*.swp
*.swo
.idea/
.vscode/
!.vscode/extensions.json

# ── Logs / scratch ───────────────────────────────────────────────────────
*.log
/tmp/
/scratch/
